{
  "name": "0x15k-office",
  "version": "4.4.2",
  "author": "0x15k - YL",
  "description": "0x15k Office AI universal suite add-in for Microsoft Word, Excel, and PowerPoint with automated installer, LaunchAgent/Windows service, live URL context, and office-ai CLI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x15k/0x15k-office.git"
  },
  "main": "server.js",
  "bin": {
    "office-ai": "./bin/office-cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "setup": "bash ./install.sh",
    "setup:win": "powershell -ExecutionPolicy Bypass -File ./install.ps1",
    "sideload": "bash ./install.sh --sideload-only",
    "sideload:win": "powershell -ExecutionPolicy Bypass -File ./install.ps1 -SideloadOnly",
    "service:status": "node bin/office-cli.js status",
    "service:restart": "node bin/office-cli.js restart",
    "cli": "node bin/office-cli.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "marked": "^18.2.1",
    "selfsigned": "^2.4.1"
  }
}
